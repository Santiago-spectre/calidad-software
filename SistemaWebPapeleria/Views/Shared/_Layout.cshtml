@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Papelería Sonia</title>
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-logo">
            <img src="~/images/logo1.jpg" alt="Logo" />
            <div>
                <span>Papelería Sonia</span>
                <p class="sidebar-role">@HttpContextAccessor.HttpContext.Session.GetString("UserRole")</p>
            </div>
        </div>
        <div class="sidebar-menu">
            <a href="/Home/Index" class="menu-item @(ViewData["Active"]?.ToString() == "Home" ? "active" : "")"><i class="bi bi-house-fill"></i> Dashboard</a>
            <a href="/Sale/Index" class="menu-item @(ViewData["Active"]?.ToString() == "Sale" ? "active" : "")"><i class="bi bi-cart-fill"></i> Ventas</a>
            <a href="/CashClosing/Index" class="menu-item @(ViewData["Active"]?.ToString() == "CashClosing" ? "active" : "")"><i class="bi bi-cash-stack"></i> Caja General</a>
            <a href="/Report/Index" class="menu-item @(ViewData["Active"]?.ToString() == "Report" ? "active" : "")"><i class="bi bi-bar-chart-fill"></i> Reportes</a>

            @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Administrador")
            {
                <a href="/Product/Index" class="menu-item @(ViewData["Active"]?.ToString() == "Product" ? "active" : "")"><i class="bi bi-box-seam-fill"></i> Productos</a>
                <a href="/Supplier/Index" class="menu-item @(ViewData["Active"]?.ToString() == "Supplier" ? "active" : "")"><i class="bi bi-truck"></i> Proveedores</a>
                <a href="/User/Index" class="menu-item @(ViewData["Active"]?.ToString() == "User" ? "active" : "")"><i class="bi bi-person-fill"></i> Usuarios</a>
            }
        </div>

        <div class="sidebar-brand-footer">
            <img src="~/images/isotipo.png" alt="SLR Cybernetics" />
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="main-content">
        <!-- BARRA SUPERIOR -->
        <div class="topbar">
            <div class="topbar-bienvenida">
                <p id="fechaHoraActual"></p>
                <h4>Bienvenido, <span class="text-accent">@HttpContextAccessor.HttpContext.Session.GetString("UserName")</span></h4>
            </div>
            <div class="topbar-derecha">
                <div class="bell-wrapper" onclick="event.stopPropagation(); toggleNotificaciones()">
                    <i class="bi bi-bell-fill bell-icon"></i>
                    <span id="bellBadge" class="bell-badge d-none">0</span>

                    <div id="bellDropdown" class="bell-dropdown" onclick="event.stopPropagation()">
                        <div class="bell-dropdown-header">
                            <span>Notificaciones</span>
                            <div class="bell-dropdown-actions">
                                <button onclick="marcarTodasLeidas()" title="Marcar todas como leídas"><i class="bi bi-check2-all"></i></button>
                                <span> | </span>
                                <button onclick="eliminarTodasNotificaciones()" title="Eliminar todas"><i class="bi bi-trash-fill"></i></button>
                            </div>
                        </div>
                        <div id="notifList">
                            <p class="dropdown-loading-text">Cargando...</p>
                        </div>
                    </div>
                </div>

                <div class="bell-wrapper" onclick="event.stopPropagation(); toggleMenuUsuario()">
                    <div class="topbar-usuario">
                        <i class="bi bi-person-circle icon-accent-lg"></i>
                        <span>@HttpContextAccessor.HttpContext.Session.GetString("UserName")</span>
                        <i class="bi bi-chevron-down icon-muted-xs"></i>
                    </div>

                    <div id="menuUsuarioDropdown" class="bell-dropdown bell-dropdown--narrow" onclick="event.stopPropagation()">
                        <div class="notif-item" onclick="abrirModalPerfil()">
                            <i class="bi bi-person-fill icon-accent-mr"></i>
                            <span class="text-white-sm">Mi Perfil</span>
                        </div>
                        <a href="/Login/Logout" class="text-decoration-none">
                            <div class="notif-item notif-item--danger">
                                <i class="bi bi-box-arrow-left icon-mr-sm"></i>
                                <span class="fs-13">Cerrar Sesión</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL MI PERFIL -->
        <div id="modalMiPerfil" class="modal-overlay">
            <div class="modal-card">
                <div class="modal-header">
                    <h5 class="modal-title">Mi Perfil</h5>
                    <button onclick="document.getElementById('modalMiPerfil').style.display='none'" class="modal-close-btn">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <form id="formMiPerfil" onsubmit="guardarPerfil(event)">
                    <div class="form-group-dark">
                        <label class="form-label-dark">Nombre</label>
                        <input type="text" id="perfilNombre" required class="form-input-dark" />
                    </div>
                    <div class="form-group-dark">
                        <label class="form-label-dark">Apellido</label>
                        <input type="text" id="perfilApellido" required class="form-input-dark" />
                    </div>
                    <div class="form-group-dark">
                        <label class="form-label-dark">Correo</label>
                        <div class="input-group-inline">
                            <input type="email" id="perfilEmail" required oninput="onPerfilEmailChange()" class="form-input-dark flex-fill" />
                            <button type="button" id="btnVerificarPerfilEmail" onclick="enviarCodigoPerfil()" class="d-none btn-gradient-cta btn-inline-action">
                                Verificar
                            </button>
                        </div>
                    </div>
                    <div id="pasoCodigoPerfil" class="d-none form-group-dark">
                        <label class="form-label-dark">Código de verificación</label>
                        <div class="input-group-inline">
                            <input type="text" id="inputCodigoPerfil" maxlength="6" placeholder="6 dígitos" class="form-input-dark flex-fill" />
                            <button type="button" onclick="confirmarCodigoPerfil()" class="btn-gradient-success btn-inline-action">
                                Confirmar
                            </button>
                        </div>
                    </div>
                    <div class="form-group-dark">
                        <label class="form-label-dark">Nueva contraseña (opcional)</label>
                        <div class="input-group-relative">
                            <input type="password" id="perfilPassword" placeholder="Dejar en blanco para no cambiarla" class="form-input-dark form-input-dark--icon" />
                            <i class="bi bi-eye-fill input-icon-toggle" onclick="togglePassword('perfilPassword', this)"></i>
                        </div>
                    </div>
                    <div class="form-group-dark">
                        <label class="form-label-dark">Repetir contraseña</label>
                        <div class="input-group-relative">
                            <input type="password" id="perfilConfirmPassword" placeholder="Repite la nueva contraseña" class="form-input-dark form-input-dark--icon" />
                            <i class="bi bi-eye-fill input-icon-toggle" onclick="togglePassword('perfilConfirmPassword', this)"></i>
                        </div>
                    </div>
                    <button type="submit" id="btnGuardarPerfil" class="btn-gradient-cta btn-block-lg">
                        <i class="bi bi-check-lg"></i> Guardar Cambios
                    </button>
                </form>
            </div>
        </div>

        @RenderBody()
    </div>

    <!-- MODAL CONFIRMAR ELIMINAR GLOBAL -->
    <div id="modalConfirmarEliminarGlobal" class="modal-overlay modal-overlay--top">
        <div class="modal-card modal-card--sm">
            <div class="icon-circle-danger">
                <i class="bi bi-trash-fill icon-danger-lg"></i>
            </div>
            <h5 class="modal-title modal-title--sm">¿Confirmar eliminación?</h5>
            <p id="mensajeConfirmarEliminar" class="modal-text-muted">Esta acción no se puede deshacer.</p>
            <div class="modal-actions">
                <button onclick="document.getElementById('modalConfirmarEliminarGlobal').style.display='none'" class="btn-cancel">
                    Cancelar
                </button>
                <button id="btnConfirmarEliminarGlobal" class="btn-gradient-danger btn-flex-action">
                    Eliminar
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toastContainer" class="toast-container-custom"></div>

    <script src="~/js/site.js"></script>
    <script src="~/js/layout.js"></script>
    <script src="~/js/notifications.js"></script>
    <script src="~/js/profile.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>