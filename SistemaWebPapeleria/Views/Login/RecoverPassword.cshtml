@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;
    var success = Context.Request.Query["success"].ToString();
    var step = "email";
    var codeVerifiedSession = HttpContextAccessor.HttpContext!.Session.GetString("CodeVerified");
    var codeVerifiedTemp = TempData["CodeVerified"]?.ToString();

    if (TempData["InfoRecover"] != null  || TempData["ShowCodeStep"] != null) step = "code";
    if (codeVerifiedSession == "true" || codeVerifiedTemp == "true") step = "reset";

    var errorRecover = TempData["ErrorRecover"]?.ToString();
    var errorVerify = TempData["ErrorVerify"]?.ToString();
    var errorReset = TempData["ErrorReset"]?.ToString();
    var infoRecover = TempData["InfoRecover"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <title>Recuperar Contraseña - Papelería Sonia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <nav class="recover-nav">
        <img src="~/images/logo1.jpg" alt="Logo" class="recover-nav-logo" />
        <span class="recover-nav-title">Papelería Sonia</span>
    </nav>

    <div class="card">

        @* ── PASO 1: Ingresar correo ── *@
        @if (step == "email")
        {
            <div class="step-header">
                <div class="step-icon-circle">
                    <i class="bi bi-envelope-fill text-accent-light fs-24"></i>
                </div>
                <h4 class="step-title">Recuperar Contraseña</h4>
                <p class="step-subtitle">Ingresa tu correo y te enviaremos un código de verificación.</p>
            </div>

            @if (success == "true")
            {
                <div class="alert-success-glass text-center">
                    <i class="bi bi-check-circle-fill me-2"></i>¡Contraseña restablecida correctamente! Ya puedes iniciar sesión.
                </div>
            }

            @if (!string.IsNullOrEmpty(errorRecover))
            {
                <div class="alert alert-glass-danger">
                    <i class="bi bi-x-circle-fill me-2"></i>@errorRecover
                </div>
            }

            <form method="post" asp-action="SendCode" asp-controller="Login">
                <div class="mb-4">
                    <label>Correo Electrónico</label>
                    <div class="position-relative">
                        <input class="form-control input-with-icon" type="email" name="email" placeholder="Ingrese su correo" required />
                        <i class="bi bi-envelope input-icon"></i>
                    </div>
                </div>
                <div class="d-grid mb-3">
                    <button class="btn btn-primary" type="submit">
                        Enviar Código &nbsp;<i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </form>
            <div class="text-center">
                <a href="/Login/Login" class="back-link"><i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión</a>
            </div>
        }

        @* ── PASO 2: Ingresar código ── *@
        @if (step == "code")
        {
            <div class="step-header">
                <div class="step-icon-circle">
                    <i class="bi bi-shield-lock-fill text-accent-light fs-24"></i>
                </div>
                <h4 class="step-title">Verificar Código</h4>
                <p class="step-subtitle">Ingresa el código de 6 dígitos que enviamos a tu correo.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorVerify))
            {
                <div class="alert alert-glass-danger">
                    <i class="bi bi-x-circle-fill me-2"></i>@errorVerify
                </div>
            }
            @if (!string.IsNullOrEmpty(infoRecover))
            {
                <div class="alert alert-glass-info">
                    <i class="bi bi-info-circle-fill me-2"></i>@infoRecover
                </div>
            }

            <form method="post" asp-action="VerifyCode" asp-controller="Login">
                <div class="mb-4">
                    <label>Código de Verificación</label>
                    <input class="form-control text-center code-input" type="text" name="code" placeholder="000000"
                           maxlength="6" required />
                </div>
                <div class="d-grid mb-3">
                    <button class="btn btn-primary" type="submit">
                        Verificar Código &nbsp;<i class="bi bi-check-circle-fill"></i>
                    </button>
                </div>
            </form>
            <div class="text-center">
                <a href="/Login/Login" class="back-link"><i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión</a>
            </div>
        }

        @* ── PASO 3: Nueva contraseña ── *@
        @if (step == "reset")
        {
            <div class="step-header">
                <div class="step-icon-circle">
                    <i class="bi bi-key-fill text-accent-light fs-24"></i>
                </div>
                <h4 class="step-title">Nueva Contraseña</h4>
                <p class="step-subtitle">Ingresa y confirma tu nueva contraseña.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorReset))
            {
                <div class="alert alert-glass-danger">
                    <i class="bi bi-x-circle-fill me-2"></i>@errorReset
                </div>
            }

            <form method="post" asp-action="ResetPassword" asp-controller="Login">
                <div class="mb-3">
                    <label>Nueva Contraseña</label>
                    <div class="position-relative">
                        <input class="form-control input-with-icon" type="password" name="newPassword" id="newPassword"
                               placeholder="Ingrese nueva contraseña" required />
                        <i class="bi bi-eye-slash-fill input-icon input-icon-clickable" id="toggleNew"
                           onclick="togglePassword('newPassword', this)"></i>
                    </div>
                </div>
                <div class="mb-4">
                    <label>Repetir Contraseña</label>
                    <div class="position-relative">
                        <input class="form-control input-with-icon" type="password" name="repeatPassword" id="repeatPassword"
                               placeholder="Repita la contraseña" required />
                        <i class="bi bi-eye-slash-fill input-icon input-icon-clickable" id="toggleRepeat"
                           onclick="togglePassword('repeatPassword', this)"></i>
                    </div>
                </div>

                <div class="d-grid mb-3">
                    <button class="btn btn-primary" type="submit">
                        Restablecer Contraseña &nbsp;<i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </form>
        }

        @* ── PASO 4: Éxito ── *@
        @if (step == "success")
        {
            <div class="step-success-header">
                <div class="step-icon-circle--lg">
                    <i class="bi bi-check-lg text-success-c step-icon--lg"></i>
                </div>
                <h4 class="step-title">¡Contraseña Restablecida!</h4>
                <p class="step-subtitle step-subtitle--wide">Tu contraseña fue actualizada correctamente. Ya puedes iniciar sesión con tu nueva contraseña.</p>
                <a href="/Login/Login" class="btn btn-primary w-100">
                    Ir al Inicio de Sesión &nbsp;<i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>